PORT=3000

# Stock quotes: free key from https://finnhub.io/register (free plan covers US listings)
FINNHUB_API_KEY="<your_api_key>"
# How often each stock is re-quoted while the US market is open (ms).
# Stretched automatically to stay under Finnhub's 60 calls/minute.
STOCK_POLL_INTERVAL_MS=60000

# Initial tickers, used until a list is saved through the API (comma-separated)
STOCK_TICKERS=AAPL,MSFT
CRYPTO_TICKERS=BTC-USD,ETH-USD

# Optional: persist ticker lists set through the API. Leave unset to keep them in memory.
MONGO_URI=mongodb://mongodb-server/stocktracker

# Browser origins allowed to open the Socket.IO connection (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
