{
  "name": "stocktracker-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node dist/server/server.js",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc -p .",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
